# ============================================================
#  Настройки доступа к GigaChat API
#  Заполните этот файл и сохраните его под именем .env
#  Никому не пересылайте значения ключей.
# ============================================================

# Ключ авторизации из личного кабинета Studio:
# проект GigaChat API -> Настройки API -> Получить ключ.
# Это готовая строка Base64 (обычно начинается с символов "MDE...").
GIGACHAT_AUTHORIZATION_KEY=

# Альтернатива: если удобнее хранить Client ID и Client Secret отдельно.
# Если заполнен GIGACHAT_AUTHORIZATION_KEY, эти две строки не нужны.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Тип доступа:
#   GIGACHAT_API_PERS — физическое лицо
#   GIGACHAT_API_CORP — юридическое лицо / ИП
#   GIGACHAT_API_B2B  — юридическое лицо (тариф B2B)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель: GigaChat-2-Max (качество), GigaChat-2-Pro, GigaChat-2-Lite (быстрее и дешевле)
GIGACHAT_MODEL=GigaChat-2-Max

# Порт локального сайта (http://localhost:3000)
PORT=3000
