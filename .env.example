# ============================================================
#  Настройки доступа к GigaChat API
#  Заполните этот файл и сохраните его под именем .env
#  Никому не пересылайте значения ключей.
# ============================================================

# Ключ авторизации из личного кабинета Studio:
# проект GigaChat API -> Настройки API -> Получить ключ.
# Это готовая строка Base64 (обычно начинается с символов "MDE...").
GIGACHAT_AUTHORIZATION_KEY=

# Альтернатива: если удобнее хранить Client ID и Client Secret отдельно.
# Если заполнен GIGACHAT_AUTHORIZATION_KEY, эти две строки не нужны.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Тип доступа:
#   GIGACHAT_API_PERS — физическое лицо
#   GIGACHAT_API_CORP — юридическое лицо / ИП
#   GIGACHAT_API_B2B  — юридическое лицо (тариф B2B)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель: GigaChat-2-Max (качество), GigaChat-2-Pro, GigaChat-2-Lite (быстрее и дешевле)
GIGACHAT_MODEL=GigaChat-2-Max

# Порт локального сайта (http://localhost:3000)
PORT=3000

# ============================================================
#  Интеграция с Битрикс24 (CRM)
#  Входящий вебхук: https://<портал>.bitrix24.ru/rest/<ID>/<токен>/
#  Права вебхука: CRM, Задачи, Уведомления (crm, task, im).
# ============================================================
B24_URL=

# Включить отправку заявок в CRM (true/false).
B24_ENABLED=true

# Ответственный за сделку и задачу. Пусто — пользователь вебхука.
B24_RESPONSIBLE_ID=

# Источник сделки и валюта.
B24_SOURCE_ID=WEB
B24_CURRENCY=RUB

# Создавать задачу и уведомление, когда ИИ просит ручную проверку.
B24_TASK_ON_HUMAN=true
B24_NOTIFY_ON_HUMAN=true

# Добавлять комментарий с черновиком ответа в таймлайн сделки.
B24_TIMELINE=true

# Таймаут одного запроса к Битрикс24, мс.
B24_TIMEOUT_MS=12000

# ============================================================
#  Журнал анонимизации (CSV)
#  Хранит только счётчики замен, тип лида и статус CRM.
#  Персональные данные и текст заявки в журнал не попадают.
# ============================================================
PRIVACY_LOG_ENABLED=true

# Путь к файлу журнала. По умолчанию logs/anonymization.csv (папка в .gitignore).
PRIVACY_LOG_FILE=
